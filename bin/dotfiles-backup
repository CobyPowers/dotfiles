#!/usr/bin/env bash

set -e

DOTFILES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)

CMD=$1
CONFIG_NAME=$2

backup_usage() {
  echo "USAGE: ${BASH_SOURCE[0]} <command> [args...]"
  echo "COMMANDS:"
  echo -e "    all\t\t→ Backs up all preexisting configuration paths found in dotfiles"
  echo -e "    new\t\t→ Adds a new config path to dotfiles"
}

backup_all() {
  for config_path in $DOTFILES_DIR/config/*; do
    CONFIG_NAME=$(basename $config_path)

    if [ -d "$HOME/.config/$CONFIG_NAME" ]; then
      rm -rf $DOTFILES_DIR/config/$CONFIG_NAME/*
      cp -r "$HOME/.config/$CONFIG_NAME" "$DOTFILES_DIR/config/."
    fi
  done

  if pacman -Qs noctalia >/dev/null; then
    mkdir -p $DOTFILES_DIR/config/noctalia
    noctalia config export >$DOTFILES_DIR/config/noctalia/config.toml
  fi

  echo "INFO: All dotfile configurations have been backed up"
}

backup_new() {
  if [ -n "$CONFIG_NAME" ]; then
    if [ -d "$HOME/.config/$CONFIG_NAME" ]; then
      rm -rf $DOTFILES_DIR/config/$CONFIG_NAME/*
      cp -r "$HOME/.config/$CONFIG_NAME" "$DOTFILES_DIR/config/."
    else
      echo "ERROR: Failed to backup config '$CONFIG_NAME', no such config exists"
      exit 1
    fi
  else
    backup_usage
    exit 1
  fi

  echo "Config '$CONFIG_NAME' has been backed up"
}

case $CMD in
all)
  backup_all
  ;;
new)
  backup_new
  ;;
*)
  backup_usage
  ;;
esac
