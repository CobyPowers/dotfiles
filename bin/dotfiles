#!/usr/bin/env bash

set -e

BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

CMD=$1

if [ $# -gt 1 ]; then
  shift
fi

dotfiles_usage() {
  echo "USAGE: ${BASH_SOURCE[0]} <command> [args...]"
  echo "COMMANDS:"
  echo -e "    sync\t\t→ Pulls the dotfile repository and copies the new configurations to the ~/.config directory"
  echo -e "    backup\t\t→ Backs up all tracked ~/.config directory configurations into the dotfile repository"
  echo -e "    commit\t\t→ Commits dotfile configuration changes and pushes them to the remote repository"
  echo -e "    diff\t\t→ Shows the differences between the current configuration backup"
  echo -e "    package\t\t→ Installs & removes system packages and updates the installed packages file"
  echo -e "    apply\t\t→ Copies dotfile configurations into ~/.config directory without updating the repository"
  echo -e "    reload\t\t→ Reloads Hyprland and Noctalia, used after configurations are synced"
  # echo -e "    push\t\t→ Pushes commits to the remote repository"
  # echo -e "    pull\t\t→ Pulls commits from the remote repository"
}

case $CMD in
sync)
  $BIN_DIR/dotfiles-pull
  $BIN_DIR/dotfiles-apply
  ;;
backup)
  $BIN_DIR/dotfiles-backup "$@"
  ;;
commit)
  $BIN_DIR/dotfiles-commit "$@"
  $BIN_DIR/dotfiles-push
  ;;
diff)
  $BIN_DIR/dotfiles-diff
  ;;
package)
  $BIN_DIR/dotfiles-package "$@"
  ;;
apply)
  $BIN_DIR/dotfiles-apply "$@"
  ;;
reload)
  $BIN_DIR/dotfiles-reload
  ;;
# push)
#   $BIN_DIR/dotfiles-push "$@"
#   ;;
# pull)
#   $BIN_DIR/dotfiles-pull "$@"
#   ;;
*)
  dotfiles_usage
  ;;
esac
